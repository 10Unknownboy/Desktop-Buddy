# ============================================
# Desktop Buddy - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ============================================

# Groq API Key (for Whisper Speech-to-Text)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (for Qwen 2.5 Response Model)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Cloud Text-to-Speech
# Path to your GCP service account JSON file
# Guide: https://cloud.google.com/text-to-speech/docs/before-you-begin
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json
