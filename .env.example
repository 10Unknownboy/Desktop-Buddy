# ============================================
# Desktop Buddy - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ============================================

# Groq API Key (for Whisper Speech-to-Text)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (for Qwen 2.5 Decision + Response Models)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# TTS.ai API Key (for Text-to-Speech)
# Get yours at: https://tts.ai
TTS_AI_API_KEY=your_tts_ai_api_key_here
